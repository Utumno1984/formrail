{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The copy-paste examples (`*.example.tsx`, ticket #403) import the package by its public name, as a
    // consumer would: resolved to the sources, so a changed API fails the typecheck at once (no rebuild).
    "paths": {
      "@formrail/pro": ["./src/index.ts"],
      "@formrail/pro/engine": ["./src/engine.ts"],
      "@formrail/pro/react-hook-form": ["./src/react-hook-form.ts"]
    },
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "test", "tsup.config.ts", "vitest.config.ts", "../core/src/types/*.d.ts"]
}
