{
  "name": "@formrail/pro",
  "version": "0.2.0",
  "private": true,
  "description": "Pro tier of Formrail (commercial license, see LICENSE). Distributed through GitHub Packages as @formrail-dev/pro.",
  "homepage": "https://formrail.dev/pro/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Utumno1984/formrail.git",
    "directory": "packages/pro"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/engine.d.ts",
        "default": "./dist/engine.js"
      },
      "require": {
        "types": "./dist/engine.d.cts",
        "default": "./dist/engine.cjs"
      }
    },
    "./react-hook-form": {
      "import": {
        "types": "./dist/react-hook-form.d.ts",
        "default": "./dist/react-hook-form.js"
      },
      "require": {
        "types": "./dist/react-hook-form.d.cts",
        "default": "./dist/react-hook-form.cjs"
      }
    },
    "./tanstack-form": {
      "import": {
        "types": "./dist/tanstack-form.d.ts",
        "default": "./dist/tanstack-form.js"
      },
      "require": {
        "types": "./dist/tanstack-form.d.cts",
        "default": "./dist/tanstack-form.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@formrail/core": "0.2.0",
    "@tanstack/react-form": "~1.33.5",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.92.0"
  },
  "peerDependenciesMeta": {
    "@formrail/core": {
      "optional": true
    },
    "@tanstack/react-form": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  },
  "devDependencies": {
    "@formrail/core": "^0.2.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tanstack/react-form": "~1.33.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
