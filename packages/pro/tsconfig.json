{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The copy-paste examples (`*.example.tsx`, ticket #403) import the package by its public name, as a
    // consumer would: resolved to the sources, so a changed API fails the typecheck at once (no rebuild).
    "paths": { "@formrail/pro": ["./src/index.ts"] },
    "types": []
  },
  // `../core/src/types`: the ambient declarations (`*.css?raw`) of the core sources reached by the story-only
  // `src/showcase/`, which reuses the Free CRUD showcase (ticket #377).
  "include": ["src", "../core/src/types/*.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
