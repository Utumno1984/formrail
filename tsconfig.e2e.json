{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // `.storybook/main.ts` is loaded by Node, which needs the extension on its relative TS imports (`./docgen.ts`).
    "allowImportingTsExtensions": true,
    "paths": { "@formrail/core": ["./packages/core/src/index.ts"] }
  },
  "include": ["e2e", "playwright.config.ts", "playwright.site.config.ts", ".storybook/*.ts", ".storybook/*.tsx", "packages/core/src/types/*.d.ts"]
}
